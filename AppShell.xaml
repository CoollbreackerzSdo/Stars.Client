<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Stars.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Stars"
    FlyoutBehavior="Disabled">

    <TabBar x:Name="RootTabBar">
        <Tab x:Name="PlayTab" Title="Reproducir" Route="play" Icon="listen.png" />
        <Tab x:Name="ConnectionTab" Title="Conexión" Route="connect" Icon="connection.png" />
        <Tab x:Name="QualityTab" Title="Calidad" Route="quality" Icon="quality.png" />
        <Tab x:Name="SettingsTab" Title="Ajustes" Route="settings" Icon="settings.png" />
    </TabBar>

</Shell>

<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Stars.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Stars.Client"
    Title="Stars"
    FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Reproducir" Route="play">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
        <Tab Title="Conexión" Route="connect">
            <ShellContent ContentTemplate="{DataTemplate local:ConnectionPage}" />
        </Tab>
        <Tab Title="Calidad" Route="quality">
            <ShellContent ContentTemplate="{DataTemplate local:QualityPage}" />
        </Tab>
        <Tab Title="Ajustes" Route="settings">
            <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>

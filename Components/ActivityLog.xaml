<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Stars.Client.Components.ActivityLog"
             x:Name="Root">

    <VerticalStackLayout Spacing="10">
        <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource SectionTitle}" />
        <CollectionView ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                        HeightRequest="{Binding ListHeight, Source={x:Reference Root}}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" Style="{StaticResource Caption}" Padding="0,4" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentView>

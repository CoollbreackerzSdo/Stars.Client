<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Stars.Client.Components"
             x:Class="Stars.Client.Components.ActivityLog"
             x:DataType="local:ActivityLog"
             x:Name="Root">
    <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource SectionTitle}" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                        HeightRequest="{Binding ListHeight, Source={x:Reference Root}}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Label Text="{Binding .}" Style="{StaticResource Caption}" Padding="0,4" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
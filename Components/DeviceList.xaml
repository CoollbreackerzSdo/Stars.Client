<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Stars.Client.Components"
             xmlns:models="clr-namespace:Stars.Client.Features.Discovery"
             x:Class="Stars.Client.Components.DeviceList"
             x:DataType="local:DeviceList"
             x:Name="Root">
    <VerticalStackLayout Spacing="10">
        <components:SectionHeader xmlns:components="clr-namespace:Stars.Client.Components"
                                  Title="{Binding Title, Source={x:Reference Root}}" />
        <CollectionView ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                        SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                        HeightRequest="{Binding ListHeight, Source={x:Reference Root}}">
            <CollectionView.EmptyView>
                <Label Text="Pulsa Buscar para encontrar servidores." Style="{StaticResource Caption}" Padding="0,6" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DiscoveredServer">
                    <Border Style="{StaticResource Inset}" Padding="14,12" Margin="0,3">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="🖥" FontSize="18" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Display}" FontSize="14" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                            <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center"
                                   TextColor="{StaticResource Signal}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>

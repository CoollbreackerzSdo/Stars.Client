<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Stars.Client.Components.HeroHeader"
             x:Name="Root">

    <Grid ColumnDefinitions="6,*" ColumnSpacing="16">
        <BoxView Grid.Column="0" WidthRequest="6" CornerRadius="3"
                 Background="{StaticResource HeroBrush}" VerticalOptions="Fill" />
        <VerticalStackLayout Grid.Column="1" Spacing="4">
            <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource AppTitle}" />
            <Label Text="{Binding Subtitle, Source={x:Reference Root}}" Style="{StaticResource PageLabel}" />
        </VerticalStackLayout>
    </Grid>

</ContentView>

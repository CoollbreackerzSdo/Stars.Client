<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Stars.Client.Components"
             x:Class="Stars.Client.Components.Readout"
             x:DataType="local:Readout"
             x:Name="Root">
    <Border Style="{StaticResource Inset}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <BoxView Grid.Column="0" WidthRequest="4" CornerRadius="2"
                     Color="{Binding Accent, Source={x:Reference Root}}" VerticalOptions="Fill" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="{Binding Label, Source={x:Reference Root}}" Style="{StaticResource SectionTitle}" FontSize="11" />
                <Label Text="{Binding Value, Source={x:Reference Root}}" Style="{StaticResource ReadoutValue}" />
                <Label Text="{Binding Hint, Source={x:Reference Root}}" Style="{StaticResource Caption}"
                       IsVisible="{Binding HasHint, Source={x:Reference Root}}" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>

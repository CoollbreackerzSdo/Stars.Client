<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Stars.Client.Components"
             xmlns:models="clr-namespace:Stars.Client.Features.Discovery"
             x:Class="Stars.Client.Components.ServerList"
             x:DataType="local:ServerList"
             x:Name="Root">
    <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource SectionTitle}" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                        SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                        HeightRequest="{Binding ListHeight, Source={x:Reference Root}}">
            <CollectionView.EmptyView>
                <Label Text="Aún no has buscado servidores." Style="{StaticResource Caption}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DiscoveredServer">
                    <Border Style="{StaticResource Tile}" Padding="12,10" Margin="0,3">
                        <Label Text="{Binding Display}" FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
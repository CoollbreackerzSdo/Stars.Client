<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Stars.Client.Components.ServerList"
             x:Name="Root">

    <VerticalStackLayout Spacing="10">
        <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource SectionTitle}" />

        <CollectionView ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged"
                        HeightRequest="{Binding ListHeight, Source={x:Reference Root}}">
            <CollectionView.EmptyView>
                <Label Text="Aún no has buscado servidores." Style="{StaticResource Caption}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tile}" Padding="16,12" Margin="0,4">
                        <Label Text="{Binding Display}" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentView>

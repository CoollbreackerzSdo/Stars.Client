<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Stars.Client.Components.StatTile"
             x:Name="Root">

    <Border Style="{StaticResource Tile}">
        <VerticalStackLayout Spacing="4">
            <Label Text="{Binding Icon, Source={x:Reference Root}}" FontSize="20" />
            <Label Text="{Binding Value, Source={x:Reference Root}}" FontFamily="OpenSansSemibold"
                   FontSize="22"
                   TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
            <Label Text="{Binding Label, Source={x:Reference Root}}" Style="{StaticResource Caption}" />
        </VerticalStackLayout>
    </Border>

</ContentView>

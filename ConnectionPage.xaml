<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Stars.Client.ConnectionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Stars.Client.Components"
             xmlns:vm="clr-namespace:Stars.Client"
             x:DataType="vm:MainViewModel"
             Title="Conexión">

    <ScrollView>
        <VerticalStackLayout Padding="20,22,20,36" Spacing="18">

            <components:AppHeader Subtitle="Conexión"
                                  Status="{Binding StatusText}"
                                  StatusColor="{Binding StatusColor}" />

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="16">
                    <components:SectionHeader Title="ENLACE" />
                    <components:LinkPicker SelectedKind="{Binding SelectedKind, Mode=TwoWay}"
                                           BluetoothSupported="{Binding BluetoothSupported}" />

                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="12" IsVisible="{Binding IsWifiMode}">
                        <Entry Grid.Column="0" Text="{Binding Host, Mode=TwoWay}"
                               Placeholder="192.168.1.10" Style="{StaticResource EntryBox}" />
                        <Entry Grid.Column="1" Text="{Binding Port, Mode=TwoWay}"
                               Placeholder="45890" Keyboard="Numeric" Style="{StaticResource EntryBox}" />
                    </Grid>

                    <Entry Text="{Binding BluetoothAddress, Mode=TwoWay}"
                           Placeholder="Dispositivo emparejado"
                           IsVisible="{Binding IsBluetoothMode}" Style="{StaticResource EntryBox}" />

                    <Button Text="Conectar" Command="{Binding ConnectCommand}" Style="{StaticResource Pill}" />
                    <Button Text="Buscar servidores" Command="{Binding DiscoverCommand}" Style="{StaticResource PillSoft}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Panel}">
                <components:DeviceList ItemsSource="{Binding Servers}"
                                       ServerSelected="OnServerSelected" ListHeight="120" />
            </Border>

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="12">
                    <components:SectionHeader Title="SALIDA DE AUDIO" />
                    <Border Style="{StaticResource Inset}">
                        <Picker ItemsSource="{Binding Outputs}"
                                SelectedItem="{Binding SelectedOutput, Mode=TwoWay}"
                                ItemDisplayBinding="{Binding Name}"
                                TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                                Title="Elige una salida" />
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

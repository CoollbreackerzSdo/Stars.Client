<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Stars.Client.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Stars.Client.Components"
             xmlns:vm="clr-namespace:Stars.Client"
             x:DataType="vm:MainViewModel"
             Title="Reproducir">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="18">
            <components:HeroHeader x:Name="Hero" Title="Stars"
                                   Subtitle="El audio de tu PC, en este dispositivo." />

            <components:FluffyCard x:Name="NowCard">
                <VerticalStackLayout Spacing="16">
                    <components:StatusBadge Text="{Binding StatusText}" Icon="●"
                                            BadgeColor="{Binding StatusColor}" />

                    <components:Equalizer Level="{Binding Level}" />

                    <Label Text="{Binding PacketsLabel}" Style="{StaticResource Caption}"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding BufferLabel}" Style="{StaticResource Caption}"
                           TextColor="{StaticResource AuroraLilac}" HorizontalOptions="Center" />

                    <ActivityIndicator IsRunning="{Binding IsReconnecting}"
                                       IsVisible="{Binding IsReconnecting}"
                                       Color="{StaticResource AuroraLilac}" />

                    <VerticalStackLayout Spacing="2">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="🔊  Volumen" Style="{StaticResource Caption}" />
                            <Label Grid.Column="2" Text="{Binding VolumeLabel}" Style="{StaticResource Caption}"
                                   TextColor="{StaticResource AuroraLilac}" />
                        </Grid>
                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                                MinimumTrackColor="{StaticResource AuroraLilac}"
                                MaximumTrackColor="#DCE5DD" ThumbColor="{StaticResource AuroraSky}" />
                    </VerticalStackLayout>

                    <Button Text="Desconectar" Command="{Binding DisconnectCommand}"
                            Style="{StaticResource PillWarm}" IsVisible="{Binding IsPlaying}" />
                    <Label Text="Ve a la pestaña «Conexión» para elegir un servidor."
                           Style="{StaticResource Caption}" HorizontalOptions="Center"
                           IsVisible="{Binding IsIdle}" />
                </VerticalStackLayout>
            </components:FluffyCard>

            <components:FluffyCard x:Name="TipCard">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Sugerencias" Style="{StaticResource SectionTitle}" />
                    <Label Text="• Si hay cortes, activa el modo adaptativo en Calidad." Style="{StaticResource Caption}" />
                    <Label Text="• Elige la salida de audio en Conexión." Style="{StaticResource Caption}" />
                    <Label Text="• Cambia el tema claro u oscuro en Ajustes." Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </components:FluffyCard>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

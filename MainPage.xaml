<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Stars.Client.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Stars.Client.Components"
             xmlns:vm="clr-namespace:Stars.Client"
             x:DataType="vm:MainViewModel"
             Title="Reproductor">

    <ScrollView>
        <VerticalStackLayout Padding="20,22,20,36" Spacing="18">

            <components:AppHeader Subtitle="Reproductor"
                                  Status="{Binding StatusText}"
                                  StatusColor="{Binding StatusColor}" />

            <!-- Live wave -->
            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="16">
                    <components:StatusPill Text="{Binding StatusText}" PillColor="{Binding StatusColor}"
                                           HorizontalOptions="Start" />

                    <components:WaveMeter Level="{Binding Level}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <components:Readout Grid.Column="0" Label="VOLUMEN" Value="{Binding VolumeLabel}"
                                            Accent="{StaticResource Indigo}" />
                        <components:Readout Grid.Column="1" Label="PAQUETES" Value="{Binding PacketsLabel}"
                                            Accent="{StaticResource Signal}" />
                    </Grid>

                    <Label Text="{Binding BufferLabel}" Style="{StaticResource Caption}" HorizontalOptions="Center"
                           TextColor="{StaticResource Signal}" />

                    <ActivityIndicator IsRunning="{Binding IsReconnecting}" IsVisible="{Binding IsReconnecting}"
                                       Color="{StaticResource Signal}" />

                    <VerticalStackLayout Spacing="4">
                        <components:SectionHeader Title="NIVEL" Trailing="{Binding VolumeLabel}" />
                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                                MinimumTrackColor="{StaticResource Signal}"
                                MaximumTrackColor="#332DD4BF" ThumbColor="{StaticResource Signal}" />
                    </VerticalStackLayout>

                    <Button Text="Desconectar" Command="{Binding DisconnectCommand}"
                            Style="{StaticResource PillWarm}" IsVisible="{Binding IsPlaying}" />
                    <Button Text="Conectar" Command="{Binding SelectServerCommand}"
                            Style="{StaticResource Pill}" IsVisible="{Binding IsIdle}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="10">
                    <components:SectionHeader Title="ATRÁS" />
                    <Label Text="• ¿Cortes? Activa el bitrate adaptativo en Calidad." Style="{StaticResource Caption}" />
                    <Label Text="• Elige salida de audio en Conexión." Style="{StaticResource Caption}" />
                    <Label Text="• Cambia de tema en Sistema." Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

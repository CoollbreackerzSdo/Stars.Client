<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================= -->
    <!--  Stars · Aurora theme — colorful, with light & dark variants   -->
    <!-- ============================================================= -->

    <!-- Accents (shared by both themes) -->
    <Color x:Key="AuroraLilac">#7C5CFF</Color>
    <Color x:Key="AuroraSky">#4EA8FF</Color>
    <Color x:Key="AuroraPink">#FF6FB5</Color>
    <Color x:Key="AuroraPeach">#FF9E6D</Color>
    <Color x:Key="AuroraMint">#35D0A5</Color>

    <!-- Light -->
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightSurfaceAlt">#F4F1FF</Color>
    <Color x:Key="LightText">#241E45</Color>
    <Color x:Key="LightTextSoft">#6B6689</Color>
    <Color x:Key="LightLine">#E9E4FF</Color>

    <!-- Dark -->
    <Color x:Key="DarkSurface">#16162A</Color>
    <Color x:Key="DarkSurfaceAlt">#1E1E38</Color>
    <Color x:Key="DarkText">#EDEBFF</Color>
    <Color x:Key="DarkTextSoft">#9C98BE</Color>
    <Color x:Key="DarkLine">#2A2A46</Color>

    <!-- Theme-aware tokens -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceAlt">#F4F1FF</Color>
    <Color x:Key="Ink">#241E45</Color>
    <Color x:Key="InkSoft">#6B6689</Color>
    <Color x:Key="Line">#E9E4FF</Color>

    <!-- Background gradients -->
    <LinearGradientBrush x:Key="PageBgLight" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7F4FF" Offset="0.0" />
        <GradientStop Color="#EAF3FF" Offset="0.5" />
        <GradientStop Color="#FFF0F8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PageBgDark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B0B16" Offset="0.0" />
        <GradientStop Color="#12122A" Offset="0.5" />
        <GradientStop Color="#1A0F22" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8A6BFF" Offset="0.0" />
        <GradientStop Color="#4EA8FF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WarmBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6FB5" Offset="0.0" />
        <GradientStop Color="#FF9E6D" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MintBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#35D0A5" Offset="0.0" />
        <GradientStop Color="#4EA8FF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7C5CFF" Offset="0.0" />
        <GradientStop Color="#4EA8FF" Offset="0.45" />
        <GradientStop Color="#FF6FB5" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ============ Global element styles ============ -->
    <Style TargetType="ContentPage">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource AuroraLilac}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource AuroraLilac}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource LightTextSoft}, Dark={StaticResource DarkTextSoft}}" />
    </Style>

    <!-- ============ Typography ============ -->
    <Style x:Key="AppTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
    </Style>

    <Style x:Key="PageLabel" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextSoft}, Dark={StaticResource DarkTextSoft}}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextSoft}, Dark={StaticResource DarkTextSoft}}" />
    </Style>

    <Style x:Key="IconGlyph" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
    </Style>

    <!-- ============ Cards, pills, entries ============ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightLine}, Dark={StaticResource DarkLine}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="26" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#337C5CFF" Offset="0,10" Radius="26" Opacity="0.22" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#554EA8FF" Offset="0,8" Radius="20" Opacity="0.4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillWarm" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{StaticResource WarmBrush}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#55FF6FB5" Offset="0,8" Radius="20" Opacity="0.4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillMint" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="TextColor" Value="#0B2A22" />
        <Setter Property="Background" Value="{StaticResource MintBrush}" />
    </Style>

    <Style x:Key="PillSoft" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource AuroraLilac}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1ECFF, Dark=#232247}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="46" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="EntryBox" TargetType="Entry">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LightTextSoft}, Dark={StaticResource DarkTextSoft}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F7F5FF, Dark=#1B1B33}" />
        <Setter Property="HeightRequest" Value="50" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F7F5FF, Dark=#1B1B33}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="AuroraLilac">#1F6B4E</Color>
    <Color x:Key="AuroraSky">#376F78</Color>
    <Color x:Key="AuroraPink">#B94E3A</Color>
    <Color x:Key="AuroraPeach">#A66A37</Color>
    <Color x:Key="AuroraMint">#B9DB78</Color>

    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightSurfaceAlt">#EFF3EF</Color>
    <Color x:Key="LightText">#15231A</Color>
    <Color x:Key="LightTextSoft">#536258</Color>
    <Color x:Key="LightLine">#DCE5DD</Color>
    <Color x:Key="DarkSurface">#19211B</Color>
    <Color x:Key="DarkSurfaceAlt">#222C24</Color>
    <Color x:Key="DarkText">#EEF4EE</Color>
    <Color x:Key="DarkTextSoft">#A6B4A8</Color>
    <Color x:Key="DarkLine">#364238</Color>

    <SolidColorBrush x:Key="PageBgLight" Color="#F3F6F3" />
    <SolidColorBrush x:Key="PageBgDark" Color="#111813" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1F6B4E" />
    <SolidColorBrush x:Key="WarmBrush" Color="#A84232" />
    <SolidColorBrush x:Key="MintBrush" Color="#B9DB78" />
    <SolidColorBrush x:Key="HeroBrush" Color="#376F78" />

    <Style TargetType="ContentPage">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource AuroraLilac}, Dark={StaticResource AuroraMint}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource AuroraLilac}, Dark={StaticResource AuroraMint}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource LightTextSoft}, Dark={StaticResource DarkTextSoft}}" />
    </Style>

    <Style x:Key="AppTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
    </Style>
    <Style x:Key="PageLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextSoft}, Dark={StaticResource DarkTextSoft}}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextSoft}, Dark={StaticResource DarkTextSoft}}" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextSoft}, Dark={StaticResource DarkTextSoft}}" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightLine}, Dark={StaticResource DarkLine}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="8" /></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Pill" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>
    <Style x:Key="PillWarm" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{StaticResource WarmBrush}" />
    </Style>
    <Style x:Key="PillMint" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="TextColor" Value="#17221A" />
        <Setter Property="Background" Value="{StaticResource MintBrush}" />
    </Style>
    <Style x:Key="PillSoft" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AuroraLilac}, Dark={StaticResource AuroraMint}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8EFE9, Dark=#29352C}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="46" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>
    <Style x:Key="EntryBox" TargetType="Entry">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LightTextSoft}, Dark={StaticResource DarkTextSoft}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F0F4F0, Dark=#222C24}" />
        <Setter Property="HeightRequest" Value="50" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="4" /></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="StrokeShape">
            <Setter.Value><RoundRectangle CornerRadius="4" /></Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
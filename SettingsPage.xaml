<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Stars.Client.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Stars.Client.Components"
             xmlns:vm="clr-namespace:Stars.Client"
             x:DataType="vm:MainViewModel"
             Title="Sistema">

    <ScrollView>
        <VerticalStackLayout Padding="20,22,20,36" Spacing="18">

            <components:AppHeader Subtitle="Sistema"
                                  Status="{Binding StatusText}"
                                  StatusColor="{Binding StatusColor}" />

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="16">
                    <components:SectionHeader Title="APARIENCIA" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.Column="0" Style="{StaticResource Chip}">
                            <Label Text="🌗" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Tema oscuro" Style="{StaticResource ItemTitle}" />
                            <Label Text="Alterna claro y oscuro." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding IsDark, Mode=TwoWay}"
                                OnColor="{StaticResource Signal}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <components:LogPanel Title="ACTIVIDAD" ItemsSource="{Binding LogLines}" ListHeight="200" />

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="6">
                    <components:SectionHeader Title="ACERCA DE" />
                    <Label Text="Stars · cliente · v1.0.0" Style="{StaticResource Caption}" />
                    <Label Text=".NET 11 · MAUI · Opus" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
